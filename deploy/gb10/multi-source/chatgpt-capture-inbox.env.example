# ChatGPT capture publisher-only environment.
# This file MUST NOT contain PostgreSQL, Hindsight, DLMF writer, or canonical-memory credentials.
# Copy outside Git with chmod 0600 and replace the path placeholders.

DLMF_CHATGPT_CAPTURE_ROOT=REPLACE_WITH_MEMORY_RUNTIME/chatgpt-capture
DLMF_CHATGPT_CAPTURE_HOST=127.0.0.1
DLMF_CHATGPT_CAPTURE_PORT=19007
DLMF_CHATGPT_CAPTURE_BEARER_TOKEN_FILE=REPLACE_WITH_MEMORY_RUNTIME/chatgpt-inbox-token
DLMF_CHATGPT_CAPTURE_MAX_BODY_BYTES=1048576
