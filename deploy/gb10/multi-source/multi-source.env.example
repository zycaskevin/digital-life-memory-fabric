# Nancy DLMF multi-source activation example.
# Copy outside Git with chmod 0600. Replace every REPLACE_WITH_* value.
# Safe default: observation/reference only. Explicitly set "distill" only after canary approval.
DLMF_MULTI_SOURCE_WRITE_MODE=reference_only
# Optional isolated evaluation only; do not use "life".
# DLMF_MULTI_SOURCE_SHADOW_NAMESPACE=shadow-multi-source-evaluation

DLMF_DLS_DATABASE_URL=REPLACE_WITH_POSTGRES_URL
DLMF_DLS_SCHEMA=dlmf_dl_nancy_v1
DLMF_DLS_ARCHIVE_ROOT=REPLACE_WITH_MEMORY_RUNTIME/archive
DLMF_DLS_HINDSIGHT_URL=http://127.0.0.1:18888
DLMF_DLS_HINDSIGHT_BANK_PREFIX=dlmf-dl-nancy-life-v1
DLMF_DLS_AGENT_ID=digital-life-stack-dl_nancy
DLMF_DLS_HINDSIGHT_DISTILLATION_PROJECTION_MODE=source_actor_only
DLMF_DLS_HINDSIGHT_ASYNC_TIMEOUT_MS=1800000
OMNIHARNESS_DIR=/srv/workspace/OmniHarness
# DLMF_DLS_HINDSIGHT_API_KEY=REPLACE_WITH_PROVIDER_KEY_IF_REQUIRED

DLMF_CODEX_SESSIONS_ROOT=REPLACE_WITH_HOME/.codex/sessions
DLMF_CODEX_INCREMENTAL_CHECKPOINT=REPLACE_WITH_MEMORY_RUNTIME/codex-incremental-checkpoint.json
DLMF_CODEX_DEVELOPMENT_EXPERIENCE_JOURNAL=REPLACE_WITH_MEMORY_RUNTIME/codex-development-experiences.jsonl
DLMF_CODEX_TENANT_ID=tenant-arthur
DLMF_CODEX_LIFE_DID=did:arthurverse:nancy
DLMF_CODEX_MEMORY_NAMESPACE=life
DLMF_CODEX_MINIMUM_IDLE_MS=300000
DLMF_CODEX_PAGE_SIZE=250

DLMF_CHATGPT_CAPTURE_ROOT=REPLACE_WITH_MEMORY_RUNTIME/chatgpt-capture
DLMF_CHATGPT_INCREMENTAL_CHECKPOINT=REPLACE_WITH_MEMORY_RUNTIME/chatgpt-incremental-checkpoint.json
DLMF_CHATGPT_DEVELOPMENT_EXPERIENCE_JOURNAL=REPLACE_WITH_MEMORY_RUNTIME/chatgpt-development-experiences.jsonl
DLMF_CHATGPT_TENANT_ID=tenant-arthur
DLMF_CHATGPT_LIFE_DID=did:arthurverse:nancy
DLMF_CHATGPT_MEMORY_NAMESPACE=life
DLMF_CHATGPT_PAGE_SIZE=250

# The publisher-only HTTP inbox uses chatgpt-capture-inbox.env.example instead.
# Never place DLMF_DLS_DATABASE_URL or Hindsight credentials in that inbox environment.
