[Unit]
Description=Digital Life DLMF ChatGPT capture sync - Nancy
After=digital-life-dl-nancy-chatgpt-capture-inbox.service
Wants=digital-life-dl-nancy-chatgpt-capture-inbox.service

[Service]
Type=oneshot
WorkingDirectory=REPLACE_WITH_DLMF_REPO
EnvironmentFile=REPLACE_WITH_MULTI_SOURCE_ENV
ExecStart=REPLACE_WITH_NODE_BIN scripts/chatgpt-capture-sync-worker.mjs
SuccessExitStatus=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=REPLACE_WITH_MEMORY_RUNTIME
UMask=0077
