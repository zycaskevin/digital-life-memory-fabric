# DLMF Relationship OS private-turn ingress — GB10 host environment template.
# Install the real file outside Git, mode 0640 or stricter.

DLMF_RELATIONSHIP_OS_HOST=127.0.0.1
DLMF_RELATIONSHIP_OS_PORT=8793
DLMF_RELATIONSHIP_OS_SCHEMA=dlmf_relationship_os
DLMF_RELATIONSHIP_OS_NAMESPACE_PREFIX=relationship.private.
DLMF_RELATIONSHIP_OS_HINDSIGHT_BANK_PREFIX=dlmf-ros-nancy
DLMF_RELATIONSHIP_OS_AGENT_ID=nancy

DLMF_RELATIONSHIP_OS_DATABASE_URL=REPLACE_WITH_POSTGRESQL_URL
DLMF_RELATIONSHIP_OS_ARCHIVE_ROOT=/var/lib/dlmf/relationship-os/raw
DLMF_RELATIONSHIP_OS_BEARER_TOKEN=REPLACE_WITH_32_PLUS_CHAR_RANDOM_BEARER
DLMF_RELATIONSHIP_OS_TENANT_ID=REPLACE_WITH_RELATIONSHIP_OS_DLMF_TENANT_ID
DLMF_RELATIONSHIP_OS_LIFE_DID=REPLACE_WITH_CANONICAL_NANCY_LIFE_DID
DLMF_RELATIONSHIP_OS_HINDSIGHT_URL=REPLACE_WITH_HINDSIGHT_URL
DLMF_RELATIONSHIP_OS_HINDSIGHT_API_KEY=REPLACE_WITH_HINDSIGHT_TENANT_KEY_IF_REQUIRED
OMNIHARNESS_DIR=/workspace/OmniHarness
