# Digital-Life-Stack -> DLMF integration service example.
# Copy outside Git and replace every REPLACE_WITH_* value before deployment.

DLMF_DLS_HOST=127.0.0.1
DLMF_DLS_PORT=8794
DLMF_DLS_DATABASE_URL=REPLACE_WITH_POSTGRES_URL
DLMF_DLS_SCHEMA=dlmf_digital_life_stack
DLMF_DLS_ARCHIVE_ROOT=/var/lib/dlmf/digital-life-stack/archive
DLMF_DLS_BEARER_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_BEARER_AT_LEAST_32_BYTES
DLMF_DLS_HINDSIGHT_URL=http://127.0.0.1:8888
DLMF_DLS_HINDSIGHT_BANK_PREFIX=dlmf-dls
DLMF_DLS_AGENT_ID=digital-life-stack
DLMF_DLS_PG_POOL_MAX=4
DLMF_DLS_DISTILLATION_POLICY=dls-distill-v1
DLMF_DLS_CANONICALIZATION_POLICY=dls-canonical-v1
DLMF_DLS_ADMISSION_POLICY=dls-admission-v1
DLMF_DLS_RETENTION_POLICY=dls-retention-v1
OMNIHARNESS_DIR=REPLACE_WITH_APPROVED_OMNIHARNESS_CHECKOUT

# Required only for a non-loopback Hindsight endpoint; remote Hindsight must be HTTPS.
# DLMF_DLS_HINDSIGHT_API_KEY=REPLACE_WITH_PROVIDER_KEY

# Upgrade-only flag. NEVER keep enabled for normal startup.
# DLMF_DLS_ALLOW_UPGRADE=1
